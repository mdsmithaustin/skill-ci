#!/bin/sh
# Claude Code for eval runs: user-level skills, settings and plugins hidden,
# login kept, and file writes allowed inside the runner's disposable workspace.
#
# --setting-sources project  drops ~/.claude/skills while keeping OAuth
#                            (--bare would drop the login too).
# --permission-mode acceptEdits  lets a case use tools that write inside the
#                            runner's disposable workspace. A -p run is
#                            otherwise denied outright. It does NOT make a
#                            written file gradable; the workspace is discarded
#                            and never harvested, which is why cases return
#                            their product inside tags (README convention six).
# Verified 2026-09-13 on Claude Code 2.1.270.
exec claude --setting-sources project --permission-mode acceptEdits "$@"
